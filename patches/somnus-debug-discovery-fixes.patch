+STAMPED_SOURCE = textwrap.dedent(
+    '''\
+    # somnus:metadata:v2
+    # somnus:
+    #   classification:
+    #     type: "source-code"
+    # somnus:end
+    """Stamped module."""
+
+
+    class Stamped:
+        def run(self) -> int:
+            return 1
+    '''
+)

+
+NESTED_IN_FUNCTION = textwrap.dedent(
+    '''\
+    def factory():
+        class Outer:
+            def a(self):
+                pass
+
+            class Inner:
+                def b(self):
+                    pass
+
+        return Outer
+
+
+    class Top:
+        def c(self):
+            pass
+
+        class TopInner:
+            def d(self):
+                pass

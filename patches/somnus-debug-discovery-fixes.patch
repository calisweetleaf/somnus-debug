+def _env(extra: dict[str, str] | None = None) -> dict[str, str]:
+    environment = os.environ.copy()
+    environment["PYTHONPATH"] = str(SRC_ROOT) + os.pathsep + environment.get("PYTHONPATH", "")
+    environment["PYTHONDONTWRITEBYTECODE"] = "1"
